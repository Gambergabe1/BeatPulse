# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional for AI Studio flows.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD sets the initial admin password. If unset, defaults to admin1234 on first start.
ADMIN_PASSWORD="admin1234"

# Vercel postgres connection (from your Postgres storage). You can also use DATABASE_URL.
POSTGRES_URL="YOUR_POSTGRES_URL"

# Vercel blob token used for storing song audio and metadata blobs.
BLOB_READ_WRITE_TOKEN="YOUR_BLOB_TOKEN"
