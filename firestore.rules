rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "mellome471@gmail.com" && request.auth.token.email_verified == true);
    }

    // ===============================================================
    // Songs Collection
    // ===============================================================
    match /songs/{songId} {
      allow read: if true; // Publicly readable
      allow create: if isAuthenticated(); // Any logged in user can share a song
      allow update, delete: if isAdmin(); // Only admin can manage community library
    }

    // ===============================================================
    // Global Scores
    // ===============================================================
    match /globalScores/{scoreId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // Replays
    // ===============================================================
    match /replays/{replayId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
